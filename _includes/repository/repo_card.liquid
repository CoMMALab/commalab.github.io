{% assign repo = include.repository %}
{% assign parts = repo.repo | split: '/' %}
{% assign owner = parts[0] %}
{% assign slug = parts[1] %}
{% if repo.name %}
  {% assign title = repo.name %}
{% else %}
  {% assign title = slug %}
{% endif %}

<div class="col-12 col-md-6 mb-3">
  <div class="card hoverable h-100 repo-card">
    <a href="https://github.com/{{ repo.repo }}" rel="external nofollow noopener" target="_blank">
      <div class="card-body">
        <h5 class="card-title">
          <i class="fa-brands fa-github"></i>
          {{ title }}
        </h5>
        <h6 class="text-muted repo-slug">{{ owner }}/{{ slug }}</h6>
        <p class="card-text repo-description">{{ repo.description }}</p>
        <div class="repo-meta">
          {% if repo.language %}
            <span class="repo-language">
              <span class="repo-language-dot lang-{{ repo.language | slugify }}"></span>
              {{ repo.language }}
            </span>
          {% endif %}
          {% if repo.stars %}
            <span class="repo-stars"><i class="fa-solid fa-star"></i> {{ repo.stars }}</span>
          {% endif %}
        </div>
      </div>
    </a>
  </div>
</div>
